# Where the API lives. Leave blank to talk to whichever host served the page —
# that works for localhost and for another device on the same network.
# Set it explicitly only to point at a different backend.
VITE_API_BASE_URL=

# true renders the whole UI from fixtures with the backend switched off.
VITE_MOCK_MODE=false

# How often the screening result screen polls while a run is in progress.
VITE_POLL_INTERVAL_MS=2000
