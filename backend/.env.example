# --- Database ---
DATABASE_URL=postgresql+psycopg://conflict:conflict@localhost:5434/conflict_screening

# --- LLM (Dev B) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-5
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
ANTHROPIC_API_KEY=sk-ant-...

# --- Matching thresholds ---
MATCH_THRESHOLD_AUTO_INCLUDE=0.80
MATCH_THRESHOLD_REVIEW=0.65
PGTRGM_PREFILTER_THRESHOLD=0.30

# --- Business rules (QRC) ---
COT_CUTOFF_DATE=2025-07-15
DCCS_STALENESS_YEARS=2
WBS_RECENT_COMPLETION_DAYS=180

# --- Source data files (absolute or relative to backend/) ---
XLSX_PATH=../sample_dataset/Sample 3.3 - 12246557 - Compiled Databases (1).xlsx
PDF_PATH=../sample_dataset/Sample 3.1 - 12246557 (1).pdf
PPTX_PATH=../reference/Quick Reference Card - SEA T&T.pptx

# --- App ---
DATA_DIR=./data
PDFTOTEXT_BIN=pdftotext
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
GRAPH_RECURSION_LIMIT=25
